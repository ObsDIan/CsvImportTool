<Window x:Class="CsvImportTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV 資料庫匯入工具 - 第一版"
        Width="1280"
        Height="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="連線字串" />
                <TextBox x:Name="ConnectionStringTextBox"
                         Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="Server=localhost\SQLEXPRESS;Database=YourDatabase;Trusted_Connection=True;TrustServerCertificate=True;" />
                <Button Grid.Column="2" Width="110" Margin="8,0,0,0" Content="讀取資料表" Click="LoadTables_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Text="資料表" />
                <ComboBox x:Name="TablesComboBox" Grid.Column="1" Height="32" DisplayMemberPath="DisplayName" />
                <Button Grid.Column="2" Width="120" Margin="8,0,0,0" Content="讀取欄位" Click="LoadColumns_Click" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Text="CSV 檔案" />
                <TextBox x:Name="CsvPathTextBox" Grid.Column="5" Height="32" VerticalContentAlignment="Center" IsReadOnly="True" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Width="80" Content="選擇" Click="BrowseCsv_Click" />
                    <Button Width="100" Margin="8,0,0,0" Content="讀取 CSV" Click="LoadCsv_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="12" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="120" Content="自動對應" Click="AutoMap_Click" />
                    <Button Width="120" Margin="8,0,0,0" Content="驗證資料" Click="Validate_Click" />
                    <Button Width="120" Margin="8,0,0,0" Content="匯入資料" Click="Import_Click" />
                    <Button Width="120" Margin="8,0,0,0" Content="匯出錯誤" Click="ExportErrors_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ProgressTextBlock" VerticalAlignment="Center" Text="0 / 0" />
                    <ProgressBar x:Name="ImportProgressBar" Width="240" Height="20" Margin="8,0,0,0" Minimum="0" Maximum="100" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="3" Margin="0,8,0,0">
            <TabItem Header="CSV 預覽">
                <DataGrid x:Name="CsvPreviewGrid"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True" />
            </TabItem>

            <TabItem Header="欄位對應">
                <DataGrid x:Name="MappingGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="匯入" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                        <DataGridTextColumn Header="DB 欄位" Binding="{Binding DbColumn}" IsReadOnly="True" Width="180" />
                        <DataGridTextColumn Header="型別" Binding="{Binding DataType}" IsReadOnly="True" Width="100" />
                        <DataGridTextColumn Header="長度" Binding="{Binding LengthDisplay}" IsReadOnly="True" Width="80" />
                        <DataGridCheckBoxColumn Header="必填" Binding="{Binding IsRequired}" IsReadOnly="True" Width="60" />
                        <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey}" IsReadOnly="True" Width="50" />
                        <DataGridCheckBoxColumn Header="Identity" Binding="{Binding IsIdentity}" IsReadOnly="True" Width="80" />
                        <DataGridComboBoxColumn x:Name="CsvColumnComboColumn"
                                                Header="CSV 欄位"
                                                SelectedItemBinding="{Binding CsvColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="220" />
                        <DataGridTextColumn Header="固定值" Binding="{Binding FixedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="驗證錯誤">
                <DataGrid x:Name="ErrorsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CSV 列號" Binding="{Binding RowNumber}" Width="100" />
                        <DataGridTextColumn Header="DB 欄位" Binding="{Binding ColumnName}" Width="180" />
                        <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" Width="220" />
                        <DataGridTextColumn Header="錯誤原因" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Margin="0,8,0,0" Padding="10" Background="#F7F7F7" CornerRadius="6">
            <TextBlock x:Name="StatusTextBlock" Text="請先設定連線字串，讀取資料表與 CSV。" />
        </Border>
    </Grid>
</Window>
