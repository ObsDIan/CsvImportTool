<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Authors>ObsDIan</Authors>
    <Description>CSV to SQL Server import tool with schema-aware validation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CsvImportTool.Tests/**/*.cs" />
    <EmbeddedResource Remove="CsvImportTool.Tests/**/*.resx" />
    <None Remove="CsvImportTool.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
</Project>
